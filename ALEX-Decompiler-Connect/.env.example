# Configure these values in your hosting service, NOT in GitHub
PUBLIC_BASE_URL=https://YOUR-ALEX-SITE.example
ROBLOX_OAUTH_CLIENT_ID=your-roblox-oauth-client-id
ROBLOX_OAUTH_CLIENT_SECRET=your-private-roblox-oauth-client-secret
